# Copy this file to .env and fill in your real values.
# Never commit .env to Git.

PORT=5000
# Local: mongodb://127.0.0.1:27017/vacation_rentals
# Atlas (Windows/Node 22): prefer Standard connection string from Atlas → Drivers → "Standard" (not SRV)
MONGODB_URI=mongodb://127.0.0.1:27017/vacation_rentals

# Resend — contact form email delivery
# 1. Sign up at https://resend.com
# 2. Create an API key: https://resend.com/api-keys
# 3. Testing: onboarding@resend.dev only delivers to the email you used to sign up for Resend.
#    Set HOST_EMAIL to that same email until you verify a domain.
# 4. Production: verify domain at https://resend.com/domains then set:
#    RESEND_FROM_EMAIL=Joseph's Retreat <noreply@yourdomain.com>
#    HOST_EMAIL=your-production-host@gmail.com
# Required for contact form + booking confirmation emails (guest + host after payment)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Joseph's Retreat <onboarding@resend.dev>
HOST_EMAIL=joeljoseph2003871@gmail.com
SITE_NAME=Joseph's Retreat

# Razorpay Standard Checkout — https://razorpay.com/docs/payments/payment-gateway/web-integration/standard/
# Test mode keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
# Optional: Dashboard → Payment Configuration → copy Config ID to lock payment methods
# RAZORPAY_CHECKOUT_CONFIG_ID=config_xxxxxxxx

# Frontend URL for CORS (comma-separate multiple origins if needed)
CLIENT_URL=http://localhost:5173

# Public site URL (used in ICS calendar links)
SITE_URL=https://your-project.vercel.app

# Airbnb calendar import
AIRBNB_ICAL_AMBER_HOUSE=https://www.airbnb.co.in/calendar/ical/1544236559464750907.ics?t=3a0f37bd6daf4590b22eb41e51e7b038
AIRBNB_ICAL_ROOFTOP_SERENITY=https://www.airbnb.co.in/calendar/ical/1666598775797444713.ics?t=bdc1de1cdf68438ea4c2202108d863b6

CALENDAR_TIMEZONE=Asia/Kolkata
