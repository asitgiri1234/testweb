# Copy this file to .env and fill in your real values.
# Never commit .env to Git.

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/vacation_rentals

# Contact form — Gmail SMTP (required for contact form to send emails)
# 1. Enable 2-Step Verification on your Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password below (no spaces)
HOST_EMAIL=joeljoseph2003871@gmail.com
SMTP_USER=joeljoseph2003871@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SITE_NAME=Joseph's Retreat

# Razorpay (Phase 4 — payment integration)
RAZORPAY_KEY_ID=your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# Frontend URL for CORS (your Vite dev server or production URL)
CLIENT_URL=http://localhost:5173
